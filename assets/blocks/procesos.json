{
  "key": "procesos",
  "version": 2,
  "description": "Lo que el equipo sabe hacer y las veces que lo hizo: proceso (qué es y qué necesita) e iteración (una vez que se hizo, con lo producido en Dropbox).",
  "entities": [
    {
      "key": "proceso",
      "label": "Proceso",
      "label_plural": "Procesos",
      "description": "Algo que el equipo sabe hacer: qué hace, con qué skill, qué necesita la máquina, qué se registra cada vez y dónde se guarda",
      "title_field": "nombre",
      "fields": [
        {
          "key": "nombre",
          "label": "Nombre",
          "type": "text",
          "required": true,
          "searchable": true
        },
        {
          "key": "estado",
          "label": "Estado",
          "type": "enum",
          "required": true,
          "default": "publicado",
          "options": [
            {
              "key": "publicado",
              "label": "Publicado"
            },
            {
              "key": "retirado",
              "label": "Retirado"
            }
          ]
        },
        {
          "key": "descripcion",
          "label": "Qué hace",
          "type": "long_text"
        },
        {
          "key": "definicion",
          "label": "Definición",
          "type": "json",
          "required": true,
          "help": "Ficha, requisitos, qué se registra y carpeta de Dropbox, en el formato de references/procesos.md de la fábrica."
        }
      ]
    },
    {
      "key": "iteracion",
      "label": "Iteración",
      "label_plural": "Iteraciones",
      "description": "Una vez que se hizo un proceso: dónde quedó en Dropbox, cómo se hizo y con qué",
      "title_field": "titulo",
      "attachments": {
        "enabled": true,
        "max_files": 20,
        "max_size_mb": 3,
        "allowed_types": [
          "image/jpeg",
          "image/png",
          "image/webp",
          "application/pdf"
        ]
      },
      "fields": [
        {
          "key": "titulo",
          "label": "Título",
          "type": "text",
          "required": true,
          "searchable": true
        },
        {
          "key": "carpeta",
          "label": "Carpeta en Dropbox",
          "type": "text",
          "required": true,
          "help": "Donde quedó lo producido: https://www.dropbox.com/… o /Clientes/…"
        },
        {
          "key": "archivos",
          "label": "Archivos",
          "type": "json",
          "help": "Los archivos que quedaron en la carpeta, comprobados al registrar."
        },
        {
          "key": "datos",
          "label": "Datos",
          "type": "json",
          "help": "Lo que el proceso pide registrar cada vez."
        },
        {
          "key": "receta",
          "label": "Receta",
          "type": "json",
          "help": "Pasos, prompts, herramientas, modelo, decisiones y descartes."
        },
        {
          "key": "skill",
          "label": "Skill",
          "type": "text",
          "help": "Con qué skill y commit se hizo: «nombre @ commit»."
        },
        {
          "key": "conversacion",
          "label": "Conversación",
          "type": "text",
          "help": "Dónde se hizo: https://… o claude://…"
        },
        {
          "key": "origen",
          "label": "Origen",
          "type": "enum",
          "required": true,
          "default": "original",
          "options": [
            {
              "key": "original",
              "label": "Así se hizo"
            },
            {
              "key": "reproduccion",
              "label": "Reproducción"
            }
          ]
        },
        {
          "key": "salio_igual",
          "label": "Salió igual",
          "type": "boolean",
          "help": "Sólo en una reproducción."
        },
        {
          "key": "que_falto",
          "label": "Qué faltó",
          "type": "long_text",
          "help": "Si una reproducción no salió igual."
        },
        {
          "key": "autor",
          "label": "Hecha por",
          "type": "person"
        },
        {
          "key": "responsable",
          "label": "Responsable",
          "type": "person",
          "help": "Opcional."
        },
        {
          "key": "estado",
          "label": "Estado",
          "type": "enum",
          "help": "Opcional.",
          "options": [
            {
              "key": "en_curso",
              "label": "En curso"
            },
            {
              "key": "terminada",
              "label": "Terminada"
            },
            {
              "key": "publicada",
              "label": "Publicada"
            }
          ]
        }
      ],
      "relationships": [
        {
          "key": "proceso",
          "label": "Proceso",
          "type": "belongs_to",
          "target": "proceso",
          "required": true,
          "on_delete": "restrict"
        }
      ]
    }
  ],
  "views": [
    {
      "key": "procesos",
      "label": "Procesos",
      "description": "Lo que el equipo sabe hacer.",
      "type": "table",
      "entity": "proceso",
      "navigation": false,
      "fields": [
        "nombre",
        "estado"
      ],
      "default_sort": {
        "field": "nombre",
        "direction": "asc"
      }
    },
    {
      "key": "iteraciones",
      "label": "Iteraciones",
      "description": "Cada vez que se hizo un proceso.",
      "type": "table",
      "entity": "iteracion",
      "navigation": false,
      "fields": [
        "titulo",
        "origen",
        "estado",
        "autor",
        "carpeta"
      ],
      "page_size": 50
    }
  ]
}
