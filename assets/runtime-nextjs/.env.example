# Una integracion de PostgreSQL del marketplace de Vercel (Supabase, Neon) inyecta
# POSTGRES_URL y POSTGRES_URL_NON_POOLING: en ese caso dejalas vacias aca.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
DATABASE_URL_DIRECT=
DATABASE_POOL_MAX=

# TLS contra un PostgreSQL gestionado. El certificado de la autoridad no es un
# secreto: es publico y su huella se puede verificar.
#
# En produccion usa DATABASE_CA_CERT con el contenido del certificado. NO uses
# DATABASE_CA_CERT_FILE ahi: en un runtime serverless la ruta no resuelve y la
# aplicacion arranca sin poder conectarse. El archivo es para local y CI.
#
# DATABASE_SSL=relaxed cifra pero no autentica al servidor; off desactiva TLS.
DATABASE_CA_CERT=
DATABASE_CA_CERT_FILE=
DATABASE_SSL=

# Public application origin used in invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk proves identity; app_user remains authoritative for role and active status.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# One-time production bootstrap used by `pnpm auth:bootstrap`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=


# Enables the passwordless role selector only outside production.
# Production ignores this value and uses src/features/auth/adapter.ts.
ALLOW_UNSAFE_LOCAL_PREVIEW=true

