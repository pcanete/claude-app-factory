DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
DATABASE_URL_DIRECT=
DATABASE_POOL_MAX=

# Public application origin used in invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk proves identity; app_user remains authoritative for role and active status.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# One-time production bootstrap used by `pnpm auth:bootstrap`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Enables the passwordless role selector only outside production.
# Production ignores this value and uses src/features/auth/adapter.ts.
ALLOW_UNSAFE_LOCAL_PREVIEW=true

# Optional: force "openai" or "gateway". When empty, the available credential is detected.
AI_PROVIDER=

# Direct OpenAI or Vercel AI Gateway. Configure one; keep secrets server-only.
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Optional comma-separated allowlist. The first model is the default.
AI_ALLOWED_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-5.4-mini,google/gemini-3.1-flash-lite
